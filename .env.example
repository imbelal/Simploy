# Simploy control plane configuration.
# Copy to .env (gitignored) and fill in real values before `docker compose up -d`.

# ---- Postgres (control-plane database) ----
# Must match between the postgres container and the api container — the
# connection string is built from these. DO NOT use the defaults in prod.
POSTGRES_DB=simploy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-random-string

# ---- Control-plane auth ----
# Generate with: openssl rand -hex 32  (must be >=32 chars)
SIMPLOY_JWT_SECRET=change-me-32-or-more-chars-random-string
SIMPLOY_ADMIN_USER=admin
SIMPLOY_ADMIN_PASSWORD=change-me

# ---- Agent shared token ----
# Must be identical on both the API and the Agent (SIMPLOY_AGENT_TOKEN).
# Generate with: openssl rand -hex 24
SIMPLOY_AGENT_TOKEN=change-me-shared-with-agent

# ---- GitHub App (optional; replaces PATs for private repos) ----
SIMPLOY_GH_APP_ID=
SIMPLOY_GH_CLIENT_ID=
SIMPLOY_GH_CLIENT_SECRET=
SIMPLOY_GH_SLUG=
# PEM file with newlines escaped. Easiest: SIMPLOY_GH_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
SIMPLOY_GH_PRIVATE_KEY=
SIMPLOY_GH_PRIVATE_KEY_FILE=

# ---- Optional ----
# Public domain the Simploy control plane is served on (via the shared Caddy).
SIMPLOY_CONTROL_DOMAIN=